{
  "name": "zanzan-template",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.5.0",
  "main": "expo-router/entry",
  "scripts": {
    "upgrade:tamagui": "yarn up '*tamagui*'@latest '@tamagui/*'@latest",
    "upgrade:tamagui:canary": "yarn up '*tamagui*'@canary '@tamagui/*'@canary",
    "check:tamagui": "tamagui check",
    "generate": "tamagui generate",
    "start": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:web:optimized": "tamagui build --target web ./app -- expo export --platform web",
    "test": "jest --watchAll",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native/eslint-plugin": "^0.85.2",
    "@react-navigation/native": "^7.1.6",
    "@tamagui/config": "^1.144.3",
    "@tamagui/lucide-icons": "^1.144.3",
    "@tamagui/toast": "^1.144.3",
    "@tanstack/react-query": "^5.100.9",
    "babel-preset-expo": "~54.0.10",
    "burnt": "^0.12.2",
    "dayjs": "^1.11.20",
    "expo": "~54.0.34",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "jotai": "^2.17.1",
    "nanoid": "^5.1.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.72.1",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tamagui": "^1.144.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@babel/core": "^7.24.6",
    "@expo/metro-runtime": "~6.1.2",
    "@tamagui/babel-plugin": "^1.144.3",
    "@tamagui/cli": "^1.144.3",
    "@tamagui/metro-plugin": "^1.144.3",
    "@types/react": "~19.1.10",
    "eslint": "^10.2.1",
    "typescript": "~5.9.2"
  }
}
